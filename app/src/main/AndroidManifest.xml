<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Media/file access uses the Storage Access Framework (document picker),
         so no broad storage permission is requested. -->

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.NinjaRun"
        android:hardwareAccelerated="true">

        <!-- configChanges: rotation and similar changes must not recreate the activity.
             MainActivity intentionally discards saved state on recreation (so a killed
             process can never restore straight into the vault), which would otherwise
             re-lock the vault every time the screen rotates. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.NinjaRun">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Registers ".adx" as a file type this app handles, so it shows up in
                 "Open with" for .adx files. Opening one only launches the app on the game
                 screen: the intent's data is deliberately never read, so it can't bypass
                 the unlock pattern or import anything. -->

            <!-- Our own MIME type (e.g. when another app shares/labels a file this way). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/x-adx" />
            </intent-filter>

            <!-- By file name: pathPattern has no real wildcard for dots, so several depths
                 are listed to also match names like "my.holiday.video.adx". -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.adx" />
                <data android:pathPattern=".*\\..*\\.adx" />
                <data android:pathPattern=".*\\..*\\..*\\.adx" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.adx" />
            </intent-filter>
        </activity>

    </application>

</manifest>
